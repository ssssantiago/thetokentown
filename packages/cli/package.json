{
  "name": "thetokentown",
  "version": "0.2.0",
  "description": "Turn your last 90 days of AI coding into a building in The Token Town.",
  "type": "module",
  "bin": {
    "thetokentown": "dist/thetokentown.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/thetokentown.mjs --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/thetokentown.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs test/*.test.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "codex",
    "grok",
    "tokens",
    "developer-tools",
    "visualization"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssssantiago/thetokentown.git",
    "directory": "packages/cli"
  },
  "homepage": "https://thetokentown.dev",
  "bugs": "https://github.com/ssssantiago/thetokentown/issues",
  "dependencies": {},
  "devDependencies": {
    "@thetokentown/core": "workspace:*",
    "@thetokentown/sources": "workspace:*",
    "@types/node": "22.19.19",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
