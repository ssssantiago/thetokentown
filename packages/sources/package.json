{
  "name": "@thetokentown/sources",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Per-tool usage loaders for The Token Town, behind one reader interface, for Node and the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@thetokentown/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssssantiago/thetokentown.git",
    "directory": "packages/sources"
  },
  "homepage": "https://thetokentown.dev"
}
